#!/usr/bin/env sh
set -e

echo "[BUILD HOOK] Installing and configuring Eloquence Suite inside chroot..."

mkdir -p /opt/eloquence-suite
mkdir -p /etc/eloquence

# Ensure /usr/local/bin/elo link points to binary wrapper if installed
if [ -f "/opt/eloquence-suite/bin/elo.sh" ]; then
    chmod +x /opt/eloquence-suite/bin/elo.sh
    ln -sf /opt/eloquence-suite/bin/elo.sh /usr/local/bin/elo
    ln -sf /opt/eloquence-suite/bin/elo.sh /usr/bin/elo
fi

echo "[BUILD HOOK] Eloquence Suite configuration complete."
