#!/usr/bin/env sh
set -e

echo "[BUILD HOOK] Applying 100% Eloquence GNU/Linux Branding, Cinnamon Desktop, Passwordless Autologin & Plymouth Boot Theme..."

# Create nopasswdlogin group if not exists
groupadd -r nopasswdlogin 2>/dev/null || true

# Pre-create live users (eloquence and user) with blank passwords
useradd -m -s /bin/bash -G sudo,video,audio,netdev,nopasswdlogin eloquence 2>/dev/null || true
useradd -m -s /bin/bash -G sudo,video,audio,netdev,nopasswdlogin user 2>/dev/null || true

passwd -d eloquence 2>/dev/null || true
passwd -d user 2>/dev/null || true
passwd -d root 2>/dev/null || true

# Copy skel contents to live users home directories
if [ -d "/etc/skel" ]; then
    cp -r /etc/skel/. /home/eloquence/ 2>/dev/null || true
    cp -r /etc/skel/. /home/user/ 2>/dev/null || true
    chown -R eloquence:eloquence /home/eloquence 2>/dev/null || true
    chown -R user:user /home/user 2>/dev/null || true
fi

# Set GRUB Distributor Name
if [ -f "/etc/default/grub" ]; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Eloquence"/' /etc/default/grub || true
fi

# Set Plymouth Boot Splash Theme
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme -R eloquence 2>/dev/null || true
fi

# Ensure /etc/os-release has Eloquence GNU/Linux branding
if [ -f "/etc/os-release" ]; then
    cat << 'EOF' > /etc/os-release
NAME="Eloquence GNU/Linux"
VERSION="2026.1 (Trixie)"
ID=eloquence
ID_LIKE=debian
VERSION_ID="2026.1"
VERSION_CODENAME=trixie
PRETTY_NAME="Eloquence GNU/Linux 2026.1"
HOME_URL="https://github.com/eloquencelinux/eloquence"
SUPPORT_URL="https://github.com/eloquencelinux/eloquence/issues"
BUG_REPORT_URL="https://github.com/eloquencelinux/eloquence/issues"
BUILD_ID="2026.1-trixie"
LOGO=eloquence-logo
EOF
fi

# Ensure /etc/issue and /etc/motd
echo "⚡ Eloquence GNU/Linux 2026.1 (Trixie) \n \l" > /etc/issue
echo "⚡ Eloquence GNU/Linux 2026.1 (Trixie)" > /etc/issue.net

# Update dconf database for Cinnamon Desktop wallpaper and GTK Dark theme
if command -v dconf >/dev/null 2>&1; then
    dconf update || true
fi

# Set LightDM as default display manager for Cinnamon
if [ -f "/etc/X11/default-display-manager" ]; then
    echo "/usr/sbin/lightdm" > /etc/X11/default-display-manager
fi

# Ensure strict permissions on sudoers.d/live file
if [ -f "/etc/sudoers.d/live" ]; then
    chmod 0440 /etc/sudoers.d/live || true
fi

# Set permissions for desktop shortcuts in /etc/skel/Desktop
if [ -d "/etc/skel/Desktop" ]; then
    chmod +x /etc/skel/Desktop/*.desktop 2>/dev/null || true
fi

echo "[BUILD HOOK] Eloquence GNU/Linux Cinnamon branding, autologin, Plymouth & wallpapers applied successfully."
