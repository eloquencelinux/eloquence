#!/usr/bin/env sh
set -e

echo "[BUILD HOOK] Applying 100% Eloquence GNU/Linux Branding, Terminal Banners & System Settings..."

# Create nopasswdlogin group if not exists
groupadd -r nopasswdlogin 2>/dev/null || true

# Remove old 'user' account if exists from base debian live-config
userdel -r user 2>/dev/null || true
rm -rf /home/user 2>/dev/null || true

# Pre-create SINGLE live user 'eloquence' with blank password
useradd -m -s /bin/bash -G sudo,video,audio,netdev,nopasswdlogin eloquence 2>/dev/null || true
passwd -d eloquence 2>/dev/null || true
passwd -d root 2>/dev/null || true

# Copy skel contents to live user home directory
if [ -d "/etc/skel" ]; then
    cp -r /etc/skel/. /home/eloquence/ 2>/dev/null || true
    chown -R eloquence:eloquence /home/eloquence 2>/dev/null || true
fi

# Set GRUB Distributor Name
if [ -f "/etc/default/grub" ]; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Eloquence"/' /etc/default/grub || true
fi

# Set Plymouth Boot Splash Theme via update-alternatives & plymouth-set-default-theme
if [ -d "/usr/share/plymouth/themes/eloquence" ]; then
    update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth /usr/share/plymouth/themes/eloquence/eloquence.plymouth 500 2>/dev/null || true
    update-alternatives --set default.plymouth /usr/share/plymouth/themes/eloquence/eloquence.plymouth 2>/dev/null || true
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme -R eloquence 2>/dev/null || true
    fi
fi

# Ensure /etc/os-release has 100% Eloquence GNU/Linux branding
if [ -f "/etc/os-release" ]; then
    cat << 'EOF' > /etc/os-release
NAME="Eloquence GNU/Linux"
VERSION="2026.1 (Trixie)"
ID=eloquence
ID_LIKE=debian
VERSION_ID="2026.1"
VERSION_CODENAME=trixie
PRETTY_NAME="Eloquence GNU/Linux 2026.1"
HOME_URL="https://github.com/eloquencelinux/eloquence"
SUPPORT_URL="https://github.com/eloquencelinux/eloquence/issues"
BUG_REPORT_URL="https://github.com/eloquencelinux/eloquence/issues"
BUILD_ID="2026.1-trixie"
LOGO=eloquence-logo
EOF
fi

# Ensure /etc/issue and /etc/motd terminal banners have 100% Eloquence branding
cat << 'EOF' > /etc/motd
===================================================================
  ⚡ Welcome to Eloquence GNU/Linux 2026.1
  Professional Enterprise Linux Distribution (Cinnamon Edition)
===================================================================

The programs included with the Eloquence GNU/Linux system are free software;
the exact distribution terms for each program are described in the
individual files in /usr/share/doc/*/copyright.

Eloquence GNU/Linux comes with ABSOLUTELY NO WARRANTY, to the extent
permitted by applicable law.
EOF

echo "⚡ Eloquence GNU/Linux 2026.1 (Trixie) \n \l" > /etc/issue
echo "⚡ Eloquence GNU/Linux 2026.1 (Trixie)" > /etc/issue.net

# Replace or clean up any debian update-motd scripts if present
if [ -d "/etc/update-motd.d" ]; then
    rm -f /etc/update-motd.d/10-uname /etc/update-motd.d/00-header 2>/dev/null || true
fi

# Update dconf database for Cinnamon Desktop wallpaper, Lockscreen and GTK Dark theme
if command -v dconf >/dev/null 2>&1; then
    dconf update || true
fi

# Set LightDM as default display manager for Cinnamon
if [ -f "/etc/X11/default-display-manager" ]; then
    echo "/usr/sbin/lightdm" > /etc/X11/default-display-manager
fi

# Replace any Debian logos or software installer icons with Eloquence Phoenix logo
if [ -f "/usr/share/pixmaps/eloquence-logo.png" ]; then
    cp /usr/share/pixmaps/eloquence-logo.png /usr/share/pixmaps/debian-logo.png 2>/dev/null || true
    cp /usr/share/pixmaps/eloquence-logo.png /usr/share/pixmaps/system-software-install.png 2>/dev/null || true
fi

# Overwrite Debian Desktop-Base lockscreen backgrounds with Eloquence Dark Wallpaper
if [ -f "/usr/share/wallpapers/eloquence-dark.jpg" ]; then
    mkdir -p /usr/share/images/desktop-base
    cp /usr/share/wallpapers/eloquence-dark.jpg /usr/share/images/desktop-base/login-background.svg 2>/dev/null || true
    cp /usr/share/wallpapers/eloquence-dark.jpg /usr/share/images/desktop-base/lockscreen-background.svg 2>/dev/null || true
    cp /usr/share/wallpapers/eloquence-dark.jpg /usr/share/images/desktop-base/default 2>/dev/null || true
fi

# Ensure Calamares branding points to Eloquence Phoenix logo
if [ -d "/etc/calamares/branding/eloquence" ]; then
    mkdir -p /usr/share/calamares/branding/eloquence /usr/share/calamares/branding/debian
    cp -r /etc/calamares/branding/eloquence/* /usr/share/calamares/branding/eloquence/ 2>/dev/null || true
    cp -r /etc/calamares/branding/eloquence/* /usr/share/calamares/branding/debian/ 2>/dev/null || true
fi

# Direct Calamares Installer autostart trigger when chosen from boot menu
cat << 'EOF' > /etc/profile.d/eloquence-calamares-autostart.sh
if grep -q "eloquence.autostart=calamares" /proc/cmdline 2>/dev/null; then
    (sleep 3 && sudo -E calamares) &
fi
EOF
chmod +x /etc/profile.d/eloquence-calamares-autostart.sh

# Ensure strict permissions on sudoers.d/live file
if [ -f "/etc/sudoers.d/live" ]; then
    chmod 0440 /etc/sudoers.d/live || true
fi

# Set permissions for desktop shortcuts in /etc/skel/Desktop
if [ -d "/etc/skel/Desktop" ]; then
    chmod +x /etc/skel/Desktop/*.desktop 2>/dev/null || true
fi

echo "[BUILD HOOK] Eloquence GNU/Linux terminal banners & system settings applied successfully."
